# cass MCP server as a systemd user unit. Render by replacing every placeholder;
# install with cass-mcp-switch.sh. Secrets enter only through
# EnvironmentFile (mode 600), never through ExecStart or Environment= lines.
[Unit]
Description=cass MCP server (Streamable HTTP, loopback)
After=network.target

[Service]
Type=simple
Environment=HOME=%h/.local/state/cass-mcp
Environment=XDG_CONFIG_HOME=%h/.local/state/cass-mcp/config
Environment=XDG_DATA_HOME=%h/.local/state/cass-mcp/data
Environment=XDG_STATE_HOME=%h/.local/state/cass-mcp/state
Environment=XDG_CACHE_HOME=%h/.cache/cass-mcp
Environment=TMPDIR=%t/cass-mcp
Environment=PATH=/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
EnvironmentFile=@@ENV_FILE@@
RuntimeDirectory=cass-mcp
StateDirectory=cass-mcp
CacheDirectory=cass-mcp
ExecStart=@@CASS_MCP_BIN@@ --bind @@BIND@@ --cass-bin @@CASS_BIN@@ --data-dir @@DATA_DIR@@ --api-config @@API_CONFIG@@ --embedding-profile @@EMBED_PROFILE@@ --rerank-profile @@RERANK_PROFILE@@ --max-concurrent 2 --max-queued 1 --max-output-bytes 131072 --request-timeout-ms 600000 --terminate-grace-ms 100 --public-origin @@PUBLIC_ORIGIN@@
Restart=on-failure

[Install]
WantedBy=default.target
