examples:

# One-shot agent triage from zero context
  cass triage --json
  cass ready --json      # accepted alias
  cass preflight --json  # accepted alias
  cass --json            # also defaults to triage for zero-context agents
  cass --json search "auth"  # leading --json is moved to the search subcommand
  cass search --query "auth" --json  # --query is accepted and converted to positional syntax
  cass search "auth" --format json  # --format json is accepted as --robot-format json
  cass search "auth" --output json  # --output json also becomes --robot-format json
  cass search "auth" --rrf-limit 5 --json  # candidate window N (replaces the removed search count flag)
  # Follow next_command when present; use discovery.schemas_command for typed clients.

# Basic search with JSON output for agents
  cass search "your query" --robot
  # Default is hybrid-preferred; add --robot-meta to see realized mode and lexical fallback reasons.
  cass search "your query" --robot --robot-meta
# Deterministic handoff pack for another agent
  cass pack "why did checkout fail" --robot --max-tokens 12000 --limit 40
  cass search "checkout" --robot-format sessions | cass pack "checkout failure" --robot --sessions-from -
  cass pack "checkout timeout after redirect" --robot --freshness-policy strict --freshness-window-seconds 604800 --require-evidence
  cass pack "checkout timeout after redirect" --robot --max-tokens 4000 --max-evidence 8 --max-sessions 3 --max-excerpt-chars 600
  cass pack "checkout timeout after redirect" --robot --fields summary,health,freshness,privacy,warnings --max-tokens 4000
  # Read warnings[] plus health/freshness/privacy before copying a pack into another prompt.
  # Contributor check for docs/goldens: rch exec -- env CARGO_TARGET_DIR=${TMPDIR:-/tmp}/rch_target_cass_answer_pack_docs cargo test --test golden_robot_docs
# Token-budgeted search with cursor + request-id
  cass search "error" --robot --max-tokens 200 --request-id run-1 --rrf-limit 2 --robot-meta
  cass search "error" --robot --cursor <_meta.next_cursor> --request-id run-1b --robot-meta

# Search with time filters
  cass search "bug" --today                 # today only
  cass search "api" --week                  # last 7 days
  cass search "feature" --days 30           # last 30 days
  cass search "fix" --since 2025-01-01      # since date
  cass search "error" --robot --rrf-limit 5 --offset 5  # paginate robot output

# Filter by agent or workspace
  cass search "error" --agent codex         # codex sessions only
  cass search "test" --workspace /myproject # specific project

# Discover session files for follow-up actions
  cass sessions --current --json             # best match for current cwd
  cass sessions --workspace /myproject --json --limit 5

# Follow up on search results
  cass view /path/to/session.jsonl -n 42   # view line 42 with context
  cass view /path/to/session.jsonl -n 42 -C 10  # 10 lines context

# Get index statistics
  cass stats --json                        # JSON stats
  cass stats                               # Human-readable stats

# Aggregation (overview queries - 99% token reduction)
  cass search "error" --json --aggregate agent    # count by agent
  cass search "*" --json --aggregate agent,workspace  # multi-field agg
  cass search "bug" --json --aggregate date --week  # time distribution

# Quick health check (ideal for agents)
  cass triage --json                       # one-shot readiness + exact next command + docs/schemas
  cass status --json                       # health check JSON
  cass health --json                       # fast readiness + recommended_action
  cass status --stale-threshold 3600       # custom stale threshold (1hr)

# Diagnostics
  cass diag --json                         # JSON diagnostic info
  cass diag --verbose                      # Human-readable with sizes

# Doctor v2 safety workflow
  cass doctor check --json                 # read-only truth surface; inspect status/risk_level/recommended_action
  cass doctor repair --dry-run --json      # read-only plan with plan_fingerprint and exact apply argv
  cass doctor repair --yes --plan-fingerprint <fp> --json  # apply only the inspected fingerprint
  cass doctor --fix --json                 # legacy safe-auto-run; branch on operation_outcome.kind and receipts
  cass doctor --fix --force-rebuild --json # derived rebuild request; still fails closed on archive/source risk
  cass introspect --json                   # response_schemas contains doctor-* contracts and redacted examples

# Persistently exclude a noisy harness from indexing
  cass sources agents list --json         # inspect exclusions
  cass sources agents exclude openclaw    # block future indexing, purge archived local data
  cass sources agents exclude openclaw --keep-indexed-data  # block future indexing only
  cass sources agents include openclaw    # re-enable indexing

# Capabilities introspection (for agent self-configuration)
  cass capabilities --json                 # First-stop JSON: workflows, mistake recoveries, commands, flags, exit codes, env vars, limits
  cass capabilities                        # Human-readable summary

# Full workflow
  cass index --full                        # index all sessions
  cass index --full --json --robot-trace-ingest 2>/tmp/cass-ingest-trace.jsonl
  cass search "cma-es" --robot             # search
  cass view <source_path> -n <line>        # examine result

# TUI drill-in quick reference
  cass tui                                 # interactive mode
  # Enter on selected result -> detail modal (Messages tab default)
  # Enter with no selected hit -> query submit behavior
  # In modal: / find, n/N next/prev, Esc exits find then closes modal, F8 opens in editor
  Rerank is off by default. --rerank uses qwen3-local with N=200/K=5. --rrf-limit N and --rerank-limit K are independent; all actual N candidates are scored before the K-result page is displayed.
  Choose --rerank-provider qwen3-local|bge-local|openrouter-qwen3-8b|openrouter-cohere-4-fast|openrouter-voyage-2.5-lite. --provider still filters the session source.
  score keeps its search meaning. rerank_score is separate and null when unscored; minimal/summary omit it unless explicitly added. JSON/compact/JSONL/TOON carry _meta.rerank without --robot-meta.
  Failure keeps original order and K-result paging; failure_reason is a short code, not response text. No automatic backend switch. Actual identity and unproven counts stay null.
  First page: cass search "auth error" --mode lexical --agent codex --rerank --rerank-provider bge-local --rrf-limit 200 --rerank-limit 5 --json
  Next page: cass search "auth error" --mode lexical --agent codex --rerank --rerank-provider bge-local --rrf-limit 200 --rerank-limit 5 --json --cursor "<next_cursor>"
  Repeat the original query, N/K, provider and filters. Only display fields and content/token budgets may change. Pages reuse a fixed window; current model requests and duration are zero, first-call facts remain. A reduced page advances by its delivered count.
